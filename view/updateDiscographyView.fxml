<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="532.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.updateDiscographyController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="533.0" pickOnBounds="true">
         <image>
            <Image url="@../resources/ratereviewbg.png" />
         </image>
      </ImageView>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#00000059" height="304.0" layoutY="95.0" stroke="WHITE" strokeType="INSIDE" width="533.0" />
      <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../resources/bg2.png" />
         </image>
      </ImageView>
      <ListView fx:id="artistListView" layoutX="75.0" layoutY="132.0" onMouseClicked="#handleArtistSelection" prefHeight="76.0" prefWidth="149.0" />
      <ListView fx:id="albumListView" layoutX="264.0" layoutY="132.0" prefHeight="147.0" prefWidth="200.0" />
      <Label alignment="CENTER" layoutX="88.0" layoutY="218.0" prefHeight="28.0" prefWidth="123.0" text=" No. of Songs Listened" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font name="pixelmix Regular" size="12.0" />
         </font></Label>
      <Label layoutX="156.0" layoutY="50.0" text="Update Discography" textFill="WHITE">
         <font>
            <Font name="04b25" size="26.0" />
         </font></Label>
      <TextField fx:id="songsListenedField" layoutX="88.0" layoutY="254.0" prefHeight="25.0" prefWidth="123.0" />
