         <font>
            <Font name="pixelmix Regular" size="12.0" />
         </font></Label>
      <Label layoutX="346.0" layoutY="109.0" text="Album" textFill="WHITE">
         <font>
            <Font name="pixelmix Regular" size="12.0" />
         </font></Label>
      <Label fx:id="errorLabel" layoutX="183.0" layoutY="83.0" prefHeight="17.0" prefWidth="181.0" />
      <Button fx:id="confirmButton" layoutX="171.0" layoutY="315.0" mnemonicParsing="false" onAction="#handleConfirm" text="Confirm">
